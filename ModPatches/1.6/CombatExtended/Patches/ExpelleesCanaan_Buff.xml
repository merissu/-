<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>东方秘星异闻 ～ the Paranormal in RimWorld</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/HediffDef[defName="ExpelleesCanaan_Buff"]/stages/li[1]/statOffsets</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/HediffDef[defName="ExpelleesCanaan_Buff"]/stages/li[1]</xpath>
            <value>
              <statOffsets />
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/HediffDef[defName="ExpelleesCanaan_Buff"]/stages/li[1]/statOffsets</xpath>
          <value>
            <statOffsets>
              <ArmorRating_Heat>2.0000</ArmorRating_Heat>
            </statOffsets>
          </value>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/HediffDef[defName="ExpelleesCanaan_Buff"]/stages/li[1]/statFactors</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/HediffDef[defName="ExpelleesCanaan_Buff"]/stages/li[1]</xpath>
            <value>
              <statFactors />
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/HediffDef[defName="ExpelleesCanaan_Buff"]/stages/li[1]/statFactors</xpath>
          <value>
            <statFactors>
          <MeleeHitChance>1.5</MeleeHitChance>
          <MeleeDamageFactor>1.5</MeleeDamageFactor>
          <InjuryHealingFactor>5.0</InjuryHealingFactor>
		      <MoveSpeed>1.5</MoveSpeed>
		      <IncomingDamageFactor>0.75</IncomingDamageFactor>
            </statFactors>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
