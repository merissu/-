<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>东方秘星异闻 ～ the Paranormal in RimWorld</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="Rukoto"]/statBases</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="Rukoto"]</xpath>
            <value>
              <statBases />
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Rukoto"]/statBases</xpath>
          <value>
            <statBases Inherit="False">
              <Mass>45</Mass>
              <Flammability>0</Flammability>
              <MeleeDodgeChance>0.13</MeleeDodgeChance>
              <MeleeCritChance>0.12</MeleeCritChance>
              <MeleeParryChance>0.09</MeleeParryChance>
              <MarketValue>1200</MarketValue>
              <PsychicSensitivity>0.5</PsychicSensitivity>
              <ToxicResistance>1</ToxicResistance>
              <ComfyTemperatureMin>-100</ComfyTemperatureMin>
              <ComfyTemperatureMax>250</ComfyTemperatureMax>
              <MeatAmount>0</MeatAmount>
              <ArmorRating_Heat>0</ArmorRating_Heat>
              <BandwidthCost>3</BandwidthCost>
              <ControlTakingTime>12</ControlTakingTime>
              <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
              <MechEnergyLossPerHP>0</MechEnergyLossPerHP>
              <WastepacksPerRecharge>5</WastepacksPerRecharge>
              <WorkSpeedGlobal>5</WorkSpeedGlobal>
              <SmokeSensitivity>0</SmokeSensitivity>
              <NightVisionEfficiency>0.8</NightVisionEfficiency>
              <MoveSpeed>10</MoveSpeed>
              <ArmorRating_Blunt>12.5</ArmorRating_Blunt>
              <ArmorRating_Sharp>15</ArmorRating_Sharp>
              <CarryWeight>50</CarryWeight>
              <CarryBulk>20</CarryBulk>
              <AimingAccuracy>1.7</AimingAccuracy>
              <ShootingAccuracyPawn>1.5</ShootingAccuracyPawn>
              <MaxHitPoints>200</MaxHitPoints>
              <EMPResistance>1</EMPResistance>
              <MechEnergyUsageFactor>0</MechEnergyUsageFactor>
              <CarryingCapacity>1500</CarryingCapacity>
              <FoodPoisonChance>0</FoodPoisonChance>
            </statBases>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Rukoto"]/tools</xpath>
          <value>
            <tools Inherit="False" />
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="Rukoto"]</xpath>
          <value>
            <li Class="CombatExtended.PartialArmorExt">
              <stats>
                <li>
                  <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
                  <parts>
                    <li>SightSensor</li>
                    <li>HearingSensor</li>
                    <li>SmellSensor</li>
                  </parts>
                </li>
                <li>
                  <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
                  <parts>
                    <li>SightSensor</li>
                    <li>HearingSensor</li>
                    <li>SmellSensor</li>
                  </parts>
                </li>
              </stats>
            </li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>