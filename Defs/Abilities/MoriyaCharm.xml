<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ========== 奇迹效果Hediff定义 ========== -->

  <!-- 星之奇迹效果 -->
<HediffDef>
  <defName>Miracle_Star_Effect</defName>
  <label>星之奇迹</label>
  <description>近战能力大幅提升。</description>
  <hediffClass>HediffWithComps</hediffClass>
  <isBad>false</isBad>
  <maxSeverity>1.0</maxSeverity>
  <comps>
    <li Class="HediffCompProperties_SeverityPerDay">
      <severityPerDay>-1.0</severityPerDay>
      <showHoursToRecover>true</showHoursToRecover>
    </li>
  </comps>
  <stages>
    <li>
      <statOffsets>
        <MeleeDamageFactor>5.0</MeleeDamageFactor>
      </statOffsets>
      <statFactors>
        <MeleeHitChance>5.0</MeleeHitChance>
        <MeleeCooldownFactor>0.25</MeleeCooldownFactor>    <!-- 近战冷却时间 -75% -->
      </statFactors>
    </li>
  </stages>
</HediffDef>

  <!-- 月之奇迹效果 -->
<HediffDef>
  <defName>Miracle_Moon_Effect</defName>
  <label>月之奇迹</label>
  <description>工作速度激增，且不会疲劳。</description>
  <hediffClass>HediffWithComps</hediffClass>
  <isBad>false</isBad>
  <maxSeverity>1.0</maxSeverity>
  <comps>
    <li Class="HediffCompProperties_SeverityPerDay">
      <severityPerDay>-1.0</severityPerDay>
      <showHoursToRecover>true</showHoursToRecover>
    </li>
  </comps>
  <stages>
    <li>
      <statFactors>
        <WorkSpeedGlobal>2.0</WorkSpeedGlobal>
        <RestFallRateFactor>0</RestFallRateFactor> <!-- 疲劳不下降 -->
      </statFactors>
      <capMods>
        <li><capacity>Consciousness</capacity><offset>1.0</offset></li>
        <li><capacity>Manipulation</capacity><offset>2.0</offset></li>
      </capMods>
    </li>
  </stages>
</HediffDef>

  <!-- 日之奇迹效果 -->
  <HediffDef>
    <defName>Miracle_Sun_Effect</defName>
    <label>日之奇迹</label>
    <description>远程射击能力大幅提升。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <comps>
        <li Class="HediffCompProperties_SeverityPerDay">
            <severityPerDay>-1.0</severityPerDay>
            <showHoursToRecover>true</showHoursToRecover>
        </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <ShootingAccuracyPawn>5.0</ShootingAccuracyPawn>   <!-- 精度 -->
        </statFactors>
        <statOffsets>
          <AimingDelayFactor>-0.75</AimingDelayFactor>        <!-- 瞄准时间 -->
          <RangedCooldownFactor>-0.75</RangedCooldownFactor> <!-- 冷却 -->
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- 山之奇迹效果 -->
