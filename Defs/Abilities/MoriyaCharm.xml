        </statFactors>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>1.0</offset></li> <!-- 意识×200% -->
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- 海之奇迹效果（清除负面 + 死亡回避） -->
  <HediffDef>
    <defName>Miracle_Sea_Effect</defName>
    <label>海之奇迹</label>
    <description>净化一切污秽，并赋予一次死亡回避。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <comps>
        <li Class="HediffCompProperties_SeverityPerDay">
            <severityPerDay>-100.0</severityPerDay>
            <showHoursToRecover>true</showHoursToRecover>
        </li>
      <!-- 清除负面状态 -->
      <li Class="merissu.HediffCompProperties_Heal" />
    </comps>
    <!-- 死亡回避通过技能直接添加 DeathRefusal，不在这个Hediff里做 -->
  </HediffDef>

