			<li>
				<label>撞击</label>
				<capacities>
				<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>FullHead</linkedBodyPartsGroup>
			</li>
		</tools>
		<comps>
			<li Class="merissu.CompProperties_YinYangRotatingGraphic" />
		</comps>
