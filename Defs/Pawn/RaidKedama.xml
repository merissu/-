<Defs>

	<DutyDef>
		<defName>Merissu_AssaultMaoyu</defName>
		<alwaysShowWeapon>true</alwaysShowWeapon>
		<hook>HighPriority</hook>
		<thinkNode Class="ThinkNode_Priority">
		<subNodes>
			<li Class="ThinkNode_Subtree">
			<treeDef>Abilities_Aggressive</treeDef>
			</li>
			<li Class="merissu.JobGiver_MaoyuHitAndRun">
				<minEscapeDist>6</minEscapeDist>
				<maxEscapeDist>15</maxEscapeDist>
				<personalSpaceSq>9</personalSpaceSq>
			</li>
			<li Class="JobGiver_AIGotoNearestHostile"/>
			<li Class="JobGiver_WanderAnywhere">
			<maxDanger>Deadly</maxDanger>
			</li>
		</subNodes>
		</thinkNode>
	</DutyDef>

  <ThinkTreeDef>
    <defName>CombatOnlyMaoyu</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_ConditionalMustKeepLyingDown">
          <subNodes>
            <li Class="ThinkNode_QueuedJob">
              <inBedOnly>true</inBedOnly>
            </li>
            <li Class="JobGiver_KeepLyingDown"/>
          </subNodes>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <li Class="JobGiver_ReactToCloseMeleeThreat"/>
        <li Class="ThinkNode_QueuedJob"/>
        <li Class="ThinkNode_ConditionalForcedGoto">
          <subNodes>
            <li Class="ThinkNode_Tagger">
              <tagToGive>Misc</tagToGive>
              <subNodes>
                <li Class="JobGiver_ForcedGoto"/>
              </subNodes>
            </li>
          </subNodes>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>LordDuty</treeDef>
        </li>
		<li Class="ThinkNode_Tagger">
			<tagToGive>Fieldwork</tagToGive> 
			<subNodes>
				<li Class="merissu.JobGiver_MaoyuHitAndRun">
					<minEscapeDist>6</minEscapeDist>
					<maxEscapeDist>15</maxEscapeDist>
					<personalSpaceSq>9</personalSpaceSq>
				</li>
			</subNodes>
		</li>
		<li Class="ThinkNode_Tagger">
          <tagToGive>Idle</tagToGive>
          <subNodes>
            <li Class="JobGiver_WanderAnywhere">
              <maxDanger>Deadly</maxDanger>
              <ticksBetweenWandersRange>600~1200</ticksBetweenWandersRange>
            </li>
          </subNodes>
        </li>
        <li Class="JobGiver_IdleError"/>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

