<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 永琳的弓箭本体 -->
  <ThingDef ParentName="TH_RangeWeapon">
    <defName>EirinBow</defName>
    <label>蓬莱弓</label>
    <description>八意永琳使用的长弓，射出的箭矢带有五种颜色的蓬莱之毒。当目标已经拥有物种毒素的效果后，最后一箭可以将其直接击杀，</description>
    <graphicData>
      <texPath>Items/eirinbow</texPath>   <!-- 弓箭贴图路径 -->
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
	<soundInteract>Bow_Large</soundInteract>
    <equippedAngleOffset>45</equippedAngleOffset>
    <uiIconScale>1.0</uiIconScale>
    <soundInteract>Interact_Bow</soundInteract>
    <statBases>
      <WorkToMake>4000</WorkToMake>
	  <MarketValue>1200</MarketValue> 
      <Mass>1</Mass>
      <AccuracyTouch>1.0</AccuracyTouch>
      <AccuracyShort>1.0</AccuracyShort>
      <AccuracyMedium>1.0</AccuracyMedium>
      <AccuracyLong>1.0</AccuracyLong>
      <RangedWeapon_Cooldown>0.5</RangedWeapon_Cooldown>
    </statBases>
    <techLevel>Medieval</techLevel>
    <weaponTags>
      <li>Touhou</li>
      <li>Bow</li>
    </weaponTags>
		<equippedStatOffsets>
			<ShootingAccuracyPawn>10</ShootingAccuracyPawn>
		</equippedStatOffsets>
    <weaponClasses>
      <li>RangedLight</li>
    </weaponClasses>
    <costList>
      <SpiritualWood>70</SpiritualWood>
      <MakaiShinkiCloth>30</MakaiShinkiCloth>
	  <FullPower>1</FullPower>
    </costList>
    <recipeMaker>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <displayPriority>400</displayPriority>
      <recipeUsers>
        <li>TableHifuuClub</li>
      </recipeUsers>
      <researchPrerequisite>PowerPoint</researchPrerequisite>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>EirinArrow</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>40</range>
        <soundCast>Shot_Bow</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>6</muzzleFlashScale>
		<soundCast>Bow_Large</soundCast>
      </li>
    </verbs>
    <tools>
      <li>
        <label>弓臂敲击</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.0</cooldownTime>
      </li>
    </tools>
	<comps>
		<li Class="merissu.CompProperties_WearerHediff">
			<hediff>EirinBow_Equipped</hediff>
		</li>
	</comps>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>EirinArrow</defName>
    <label>蓬莱箭</label>
    <graphicData>
      <texPath>Items/eirinarrow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.2,1.2)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>EirinPoison</damageDef>   <!-- 使用自定义伤害类型 -->
      <speed>50</speed>
      <damageAmountBase>20</damageAmountBase>
      <stoppingPower>1</stoppingPower>
    </projectile>
  </ThingDef>
  
<HediffDef>
    <defName>EirinPoisonRed</defName>
	<defaultLabelColor>(220,50,50)</defaultLabelColor>
    <label>蓬莱之毒·红</label>
    <description>血液沸腾，易燃且持续灼烧。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>0.5</maxSeverity>
<comps>
  <li Class="HediffCompProperties_SeverityPerDay">
    <severityPerDay>-4</severityPerDay>
    <showHoursToRecover>true</showHoursToRecover>
  </li>
  <li Class="TouhouExpansion.HediffCompProperties_PoisonDamage">
    <damagePerSecond>2</damagePerSecond>
    <damageDef>Flame</damageDef>
  </li>
</comps>
    <stages>
      <li>
        <statFactors>
          <Flammability>3.0</Flammability>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- ========== 蓬莱之毒·蓝 ========== -->
  <HediffDef>
    <defName>EirinPoisonBlue</defName>
	<defaultLabelColor>(50,120,220)</defaultLabelColor>
    <label>蓬莱之毒·蓝</label>
    <description>血液冻结，行动迟缓且持续冻伤。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>0.5</maxSeverity>
<comps>
  <li Class="HediffCompProperties_SeverityPerDay">
    <severityPerDay>-4</severityPerDay>
    <showHoursToRecover>true</showHoursToRecover>
  </li>
  <li Class="TouhouExpansion.HediffCompProperties_PoisonDamage">
    <damagePerSecond>2</damagePerSecond>
    <damageDef>Frostbite</damageDef>
  </li>
</comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>0.5</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- ========== 蓬莱之毒·黄 ========== -->
  <HediffDef>
    <defName>EirinPoisonYellow</defName>
	<defaultLabelColor>(220,200,50)</defaultLabelColor>
    <label>蓬莱之毒·黄</label>
    <description>肌肉僵化，近战攻击速度大幅下降。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>0.5</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-4</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MeleeCooldownFactor>2.0</MeleeCooldownFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- ========== 蓬莱之毒·绿 ========== -->
  <HediffDef>
    <defName>EirinPoisonGreen</defName>
	<defaultLabelColor>(50,200,80)</defaultLabelColor>
    <label>蓬莱之毒·绿</label>
    <description>肉体腐朽，受到的所有伤害翻倍。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>0.5</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-4</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <IncomingDamageFactor>2.0</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- ========== 蓬莱之毒·紫 ========== -->
  <HediffDef>
    <defName>EirinPoisonPurple</defName>
	<defaultLabelColor>(160,50,200)</defaultLabelColor>
    <label>蓬莱之毒·紫</label>
    <description>视觉神经受损，完全失明。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>0.5</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-4</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <setMax>0</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  
<DamageDef ParentName="Arrow">
  <defName>EirinPoison</defName>
  <label>蓬莱之毒</label>
  <workerClass>TouhouExpansion.DamageWorker_EirinPoison</workerClass>   <!-- 改用自定义 Worker -->
  <externalViolence>true</externalViolence>
  <deathMessage>{0} 被月之毒侵蚀殆尽。</deathMessage>
  <armorCategory>Sharp</armorCategory>
</DamageDef>

<AbilityDef>
  <defName>Eirin_Heal</defName>
  <label>蓬莱急救术</label>
  <description>消耗1层灵力，瞬间治愈目标所有负面状态。</description>
  <abilityClass>TouhouExpansion.Ability_EirinHeal</abilityClass>
  <cooldownTicksRange>600</cooldownTicksRange>
  <targetRequired>true</targetRequired>
  <verbProperties>
    <verbClass>Verb_CastAbility</verbClass>
    <range>40</range>
    <warmupTime>0.5</warmupTime>
    <targetParams>
      <canTargetSelf>true</canTargetSelf>
      <canTargetAnimals>true</canTargetAnimals>
      <canTargetPawns>true</canTargetPawns>
    </targetParams>
  </verbProperties>
  <iconPath>Items/eirinheal</iconPath>
</AbilityDef>

<AbilityDef>
  <defName>Eirin_MillionArrows</defName>
  <label>蓬莱箭雨</label>
  <description>消耗1层灵力，向前方扇形区域射出大量箭矢。</description>
  <abilityClass>TouhouExpansion.Ability_EirinMillionArrows</abilityClass>
  <cooldownTicksRange>600</cooldownTicksRange>   <!-- 10秒冷却 -->
  <targetRequired>true</targetRequired>
  <verbProperties>
    <verbClass>Verb_CastAbility</verbClass>
    <range>40</range>
    <warmupTime>0.5</warmupTime>
	<soundCast>spell</soundCast>
    <targetParams>
  <canTargetSelf>true</canTargetSelf>
  <canTargetAnimals>true</canTargetAnimals>
  <canTargetPawns>true</canTargetPawns>
    </targetParams>
  </verbProperties>
  <iconPath>Items/eirinarrowrain</iconPath>
</AbilityDef>

<HediffDef>
  <defName>EirinBow_Equipped</defName>
  <label>蓬莱弓装备中</label>
  <description>装备了八意永琳的蓬莱弓。</description>
  <hediffClass>HediffWithComps</hediffClass>
  <isBad>false</isBad>
  <maxSeverity>1.0</maxSeverity>
  <abilities>
    <li>Eirin_Heal</li>
	<li>Eirin_MillionArrows</li>
  </abilities>
</HediffDef>

<ThingDef>
  <defName>EirinMillionArrowsEmitter</defName>
  <label>蓬莱箭雨发射器</label>
  <thingClass>TouhouExpansion.Thing_EirinMillionArrowsEmitter</thingClass>
  <category>Ethereal</category>
  <selectable>false</selectable>
  <drawGUIOverlay>false</drawGUIOverlay>
  <tickerType>Normal</tickerType>
  <altitudeLayer>MoteOverhead</altitudeLayer>
  <useHitPoints>false</useHitPoints>
 <graphicData>
  <texPath>Items/kongbai</texPath>
  <graphicClass>Graphic_Single</graphicClass>
</graphicData>
</ThingDef>
</Defs>
